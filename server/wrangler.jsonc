{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "profile",
	"compatibility_date": "2026-08-01",
    "compatibility_flags": [
      "nodejs_compat"
    ],
	"main": "src/main.ts",
	"observability": {
		"enabled": true
	},
    "d1_databases": [
          {
              "binding": "profile",
              "database_name": "profile",
              "database_id": "5f67155b-4299-4b09-a523-de2fc39d73b8"
          }
      ],
    "secrets": {
      "required": ["TRACKBEAR_API_KEY", "JWT_SECRET"]
    }
}